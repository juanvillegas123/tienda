# Base de datos Turso
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu-token-turso

# Seguridad y sesión
JWT_SECRET=genera-una-clave-larga-y-aleatoria
COOKIE_SECRET=genera-otra-clave-aleatoria
FRONTEND_URL=http://localhost:4200
PORT=3000

# Almacenamiento de imágenes (Cloudflare R2)
R2_ACCOUNT_ID=tu-account-id-de-cloudflare
R2_ACCESS_KEY_ID=tu-access-key-id-r2
R2_SECRET_ACCESS_KEY=tu-secret-access-key-r2
R2_BUCKET_NAME=nombre-de-tu-bucket
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
